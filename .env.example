# TapOrder AI — key NAMES only, no values (PRD 9/T9). Copy to .env and fill in.
DATABASE_URL="file:./dev.db"
HMAC_SECRET=
SESSION_SECRET=
WEBHOOK_SECRET=
STAFF_PIN=
# public base URL of the deployed app (or ngrok https URL in dev). Used to build signed QR URLs.
PUBLIC_BASE_URL=http://localhost:3000
RESTAURANT_ID=cafe-demo
RESTAURANT_NAME=Demo Cafe
SESSION_TTL_MINUTES=90
# voice provider (omnidim | vapi) — set after Phase 0 spike (PRD 7.5)
VOICE_PROVIDER=omnidim
# public widget id only — never a secret key (PRD 9/T9)
OMNIDIM_AGENT_ID=
OMNIDIM_WIDGET_ID=
VAPI_PUBLIC_KEY=
# server-side only provider keys
OMNIDIM_API_KEY=
VAPI_API_KEY=
# optional engagement links (Screen 2 only, PRD 3.4)
GOOGLE_REVIEW_URL=
INSTAGRAM_HANDLE=
WHATSAPP_NUMBER=

# demo convenience: /table/N auto-provisions a session (QR scan deferred). Set 0 for judging.
DEMO_OPEN_TABLES=
